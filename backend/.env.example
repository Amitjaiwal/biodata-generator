# Production settings for the backend. Set these in your hosting dashboard; never commit real values.
SPRING_PROFILES_ACTIVE=prod

# Managed PostgreSQL (for example Neon or Supabase). JDBC format.
DATABASE_URL=jdbc:postgresql://HOST:5432/DBNAME?sslmode=require
DATABASE_USERNAME=
DATABASE_PASSWORD=

# Razorpay Dashboard > Account & Settings > API Keys
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
# Razorpay Dashboard > Webhooks. URL: https://YOUR-BACKEND-HOST/api/payments/webhook
# Events: payment.captured, order.paid
RAZORPAY_WEBHOOK_SECRET=

# Random string of 32+ characters used to sign purchase tokens. Generate with: openssl rand -hex 32
APP_ENTITLEMENT_SECRET=

# Site origins allowed to call the API directly (comma separated).
APP_CORS_ALLOWED_ORIGINS=https://marriagesbiodatamaker.com

# Optional: prices in paise and access period in days.
APP_PRICE_PREMIUM_SINGLE=4900
APP_PRICE_PREMIUM_COLLECTION=9900
APP_VALIDITY_DAYS=365
